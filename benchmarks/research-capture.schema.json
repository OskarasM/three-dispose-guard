{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OskarasM/three-dispose-guard/blob/main/benchmarks/research-capture.schema.json",
  "title": "three-dispose-guard research capture",
  "description": "Schema v2 for a provenance-complete six-scenario lifecycle capture.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "captureId",
    "capturedAt",
    "measuredAt",
    "runs",
    "cyclesPerRun",
    "warmupCycles",
    "protocol",
    "packageVersions",
    "benchmarks",
    "summary",
    "scenarioRuns",
    "scenarioSummary",
    "proofs",
    "provenance",
    "environment"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifactKind": { "const": "provenance-complete-capture" },
    "captureId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "measuredAt": { "type": "string", "format": "date-time" },
    "runs": { "type": "integer", "minimum": 1 },
    "cyclesPerRun": { "type": "integer", "minimum": 1 },
    "warmupCycles": { "type": "integer", "minimum": 1 },
    "renderer": { "type": "string" },
    "browser": { "type": "string" },
    "protocol": {
      "type": "object",
      "required": ["scenarioOrder", "executionOrder", "nativeUniqueImplementation"],
      "properties": {
        "scenarioOrder": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scenarioId" }
        },
        "executionOrder": { "const": "fixed" },
        "nativeUniqueImplementation": { "const": "r3f-create-root" }
      },
      "additionalProperties": false
    },
    "packageVersions": {
      "type": "object",
      "required": ["three", "react", "r3f", "disposeGuard"],
      "properties": {
        "three": { "$ref": "#/$defs/exactVersion" },
        "react": { "$ref": "#/$defs/exactVersion" },
        "r3f": { "$ref": "#/$defs/exactVersion" },
        "disposeGuard": { "$ref": "#/$defs/exactVersion" }
      },
      "additionalProperties": false
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/benchmarkReport" }
    },
    "summary": {
      "type": "object",
      "required": ["unmanaged", "naive", "native", "guarded"],
      "additionalProperties": { "$ref": "#/$defs/variantSummary" }
    },
    "scenarioRuns": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["run", "report"],
        "properties": {
          "run": { "type": "integer", "minimum": 1 },
          "report": { "$ref": "#/$defs/scenarioReport" }
        },
        "additionalProperties": false
      }
    },
    "scenarioSummary": {
      "type": "object",
      "required": ["unique", "shared", "cache", "canvas", "churn", "in-flight"],
      "additionalProperties": { "$ref": "#/$defs/scenarioSummary" }
    },
    "proofs": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioReport" }
    },
    "provenance": {
      "type": "object",
      "required": ["git", "packageLock", "packageVersions", "timezone", "runtime"],
      "properties": {
        "git": {
          "type": "object",
          "required": ["commit", "workingTreeDirty"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workingTreeDirty": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "packageLock": {
          "type": "object",
          "required": ["sha256", "lockfileVersion"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "lockfileVersion": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "packageVersions": { "type": "object" },
        "timezone": {
          "type": "object",
          "required": ["name", "offsetMinutes"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "offsetMinutes": { "type": "integer", "minimum": -840, "maximum": 840 }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": ["node", "captureScript"],
          "properties": {
            "node": { "type": "string" },
            "captureScript": { "const": "scripts/capture-benchmark.mjs" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "platform",
        "cpu",
        "logicalProcessors",
        "totalMemoryGiB",
        "browser",
        "browserVersion",
        "headless",
        "gpuRenderer"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "exactVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "scenarioId": {
      "enum": ["unique", "shared", "cache", "canvas", "churn", "in-flight"]
    },
    "sample": {
      "type": "object",
      "required": ["cycle", "geometries", "textures", "programs"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 1 },
        "geometries": { "type": "integer", "minimum": 0 },
        "textures": { "type": "integer", "minimum": 0 },
        "programs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "variantReport": {
      "type": "object",
      "required": ["samples", "final", "peak"],
      "properties": {
        "samples": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
        "final": { "$ref": "#/$defs/sample" },
        "peak": { "$ref": "#/$defs/sample" }
      },
      "additionalProperties": false
    },
    "benchmarkReport": {
      "type": "object",
      "required": [
        "cycles",
        "unmanaged",
        "naive",
        "native",
        "guarded",
        "renderer",
        "browser",
        "measuredAt"
      ],
      "properties": {
        "cycles": { "type": "integer", "minimum": 1 },
        "unmanaged": { "$ref": "#/$defs/variantReport" },
        "naive": { "$ref": "#/$defs/variantReport" },
        "native": { "$ref": "#/$defs/variantReport" },
        "guarded": { "$ref": "#/$defs/variantReport" },
        "renderer": { "type": "string" },
        "browser": { "type": "string" },
        "measuredAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "variantSummary": {
      "type": "object",
      "required": ["finalTotals", "minimum", "maximum", "mean", "variance"],
      "properties": {
        "finalTotals": { "type": "array", "items": { "type": "number" } },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "variance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["label", "passed", "detail"],
      "properties": {
        "label": { "type": "string" },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["variant", "outcome", "measured", "detail"],
      "properties": {
        "variant": { "enum": ["unmanaged", "naive", "native", "guarded"] },
        "outcome": {
          "enum": ["safe", "unsafe", "retained", "not-measured", "not-applicable"]
        },
        "measured": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scenarioReport": {
      "type": "object",
      "required": [
        "scenario",
        "title",
        "measuredAt",
        "cycles",
        "renderer",
        "browser",
        "series",
        "assertions",
        "comparisons",
        "notes"
      ],
      "properties": {
        "scenario": { "$ref": "#/$defs/scenarioId" },
        "title": { "type": "string" },
        "measuredAt": { "type": "string", "format": "date-time" },
        "cycles": { "type": "integer", "minimum": 1 },
        "renderer": { "type": "string" },
        "browser": { "type": "string" },
        "series": { "type": "object" },
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "comparisons": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            { "contains": { "properties": { "variant": { "const": "unmanaged" } }, "required": ["variant"] } },
            { "contains": { "properties": { "variant": { "const": "naive" } }, "required": ["variant"] } },
            { "contains": { "properties": { "variant": { "const": "native" } }, "required": ["variant"] } },
            { "contains": { "properties": { "variant": { "const": "guarded" } }, "required": ["variant"] } }
          ],
          "items": { "$ref": "#/$defs/comparison" }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "benchmark": { "$ref": "#/$defs/benchmarkReport" }
      },
      "additionalProperties": false
    },
    "scenarioSummary": {
      "type": "object",
      "required": [
        "executions",
        "assertions",
        "passedAssertions",
        "failedAssertions",
        "passRate"
      ],
      "properties": {
        "executions": { "type": "integer", "minimum": 1 },
        "assertions": { "type": "integer", "minimum": 0 },
        "passedAssertions": { "type": "integer", "minimum": 0 },
        "failedAssertions": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
