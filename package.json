{
  "name": "three-dispose-guard",
  "version": "0.1.0",
  "description": "Audit-first ownership and safe disposal for shared, cached and primitive Three.js resources.",
  "type": "module",
  "license": "MIT",
  "author": "Oskaras Margevicius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarasM/three-dispose-guard.git"
  },
  "homepage": "https://three-dispose-guard.vercel.app",
  "bugs": {
    "url": "https://github.com/OskarasM/three-dispose-guard/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "gpu",
    "dispose",
    "memory",
    "react-three-fiber",
    "r3f",
    "ownership",
    "resource-lifecycle"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./r3f": {
      "import": {
        "types": "./dist/r3f.d.ts",
        "default": "./dist/r3f.js"
      },
      "require": {
        "types": "./dist/r3f.d.cts",
        "default": "./dist/r3f.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsup src/index.ts src/react.tsx src/r3f.tsx --format esm,cjs --dts --clean --external three --external react --external @react-three/fiber",
    "demo:build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --project=chromium",
    "test:browser:smoke": "playwright test --project=firefox --project=webkit --grep @smoke --workers=1",
    "benchmark:capture": "node scripts/capture-benchmark.mjs",
    "package:check": "npm run build && node scripts/package-smoke.mjs",
    "test:browser:all": "npm run test:browser && npm run test:browser:smoke",
    "release:check": "npm run check && npm run test:browser:all && npm run package:check && npm run benchmark:chart",
    "benchmark:chart": "node scripts/render-benchmark-chart.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run demo:build"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8 <10",
    "react": ">=18 <20",
    "three": ">=0.163 <1"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
